DATABASE_URL="mysql://nexus:nexus_password@localhost:3306/nexus_fraud"
MYSQL_DATABASE="nexus_fraud"
MYSQL_USER="nexus"
MYSQL_PASSWORD="nexus_password"
MYSQL_ROOT_PASSWORD="root_password"
AUTH_SECRET="replace-with-at-least-32-random-characters"
NEXT_PUBLIC_APP_NAME="NEXUS Fraud Detection"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@example.com"
SMTP_PASS="your-app-password"
SMTP_FROM="NEXUS Fraud Detection <your-email@example.com>"
# AI explanation provider (OpenAI-compatible chat/completions).
# Admin can override at runtime via SystemSetting; env is the default.
# AI_PROVIDER="deepseek"
# AI_API_KEY=""
# AI_BASE_URL="https://api.deepseek.com"
# AI_MODEL="deepseek-chat"
# Legacy DeepSeek names (fallback if AI_* unset).
# DEEPSEEK_API_KEY=""
# DEEPSEEK_BASE_URL="https://api.deepseek.com"
# DEEPSEEK_MODEL="deepseek-chat"
# Optional: Redis for distributed rate limits / job locks.
# REDIS_URL="redis://localhost:6379"
# Optional internal XGBoost model API. When unset, deterministic analysis remains
# fully functional and the website records the model as unavailable.
# MODEL_API_URL="http://localhost:8001"
# MODEL_API_SECRET="replace-with-a-long-random-model-service-secret"
# MODEL_API_TIMEOUT_MS="1500"
