DATABASE_URL="mysql://nexus:nexus_password@localhost:3306/nexus_fraud"
MYSQL_DATABASE="nexus_fraud"
MYSQL_USER="nexus"
MYSQL_PASSWORD="nexus_password"
MYSQL_ROOT_PASSWORD="root_password"
AUTH_SECRET="replace-with-at-least-32-random-characters"
NEXT_PUBLIC_APP_NAME="NEXUS Fraud Detection"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@example.com"
SMTP_PASS="your-app-password"
SMTP_FROM="NEXUS Fraud Detection <your-email@example.com>"
# Shared secret for the n8n automation ingest endpoints (POST /api/n8n/*).
# Generate with: openssl rand -base64 32
WHATSAPP_INGEST_SECRET="replace-with-base64-random-secret"
# Optional: lets the analysis pipeline call DeepSeek directly. n8n may own
# this key instead — NEXUS never requires it.
# DEEPSEEK_API_KEY=""
# DEEPSEEK_BASE_URL="https://api.deepseek.com"
# DEEPSEEK_MODEL="deepseek-chat"
# Optional: Redis for distributed rate limits / job locks.
# REDIS_URL="redis://localhost:6379"
